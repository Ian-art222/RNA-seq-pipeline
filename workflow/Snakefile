STRAND_LOG_DIR = QUANT_LOG_DIR / "strandness"
STRAND_ENV = str(STRAND_QC_DIR / "{sample}.env")
STRAND_DIAGNOSTIC = str(STRAND_LOG_DIR / "strandness_diagnostic.tsv")
