STRAND_BED = str(REFERENCE_DIR / "reference.bed12")
NORMALIZED_GTF = str(REFERENCE_DIR / "reference.gtf")
READ_LENGTH_SCRIPT = str(SCRIPTS_DIR / "read_lengths.py")
READ_LENGTH_REPORT = str(ALIGN_DIR / "read_lengths" / "{sample}.json")
READ_LENGTHS = str(ALIGN_DIR / "read_lengths.json")
BAM_VALIDATION = str(REFERENCE_DIR / "bam_validation" / "{sample}.json")
EXTERNAL_BED = str(workdir_path(STRAND_CONFIG["bed12"])) if STRANDED and STRAND_CONFIG.get("bed12") else ""
HISAT2_INDEX_PREFIX = str(workdir_path(config["reference"]["hisat2_index_prefix"]))
ANNOTATION = str(workdir_path(config["reference"]["annotation"]))
R1_SUFFIX = config["sample_scan"]["r1_suffix"]
R2_SUFFIX = config["sample_scan"]["r2_suffix"]
STRICT_SCAN = parse_stranded(config["sample_scan"].get("strict", True), "sample_scan.strict")
USE_BALLGOWN = parse_stranded(config["stringtie"].get("use_ballgown", True), "stringtie.use_ballgown")
def validate_suffixes(r1_suffix, r2_suffix, label):
    for value in (r1_suffix, r2_suffix):
        if not isinstance(value, str) or not value or re.search(r"[/\\*?\[\]{}\x00-\x1f]", value):
            raise ValueError(f"{label} R1/R2 suffixes must be nonempty filename suffixes without path separators, wildcards, braces or control characters")
    if r1_suffix == r2_suffix:
        raise ValueError(f"{label} R1/R2 suffixes must be distinct")
validate_suffixes(R1_SUFFIX, R2_SUFFIX, "sample_scan")
RAW_SCAN = config.get("raw_sample_scan", {})
if not isinstance(RAW_SCAN, dict):
    raise ValueError("raw_sample_scan must be a mapping with R1/R2 suffixes and strict settings")
RAW_R1_SUFFIX = RAW_SCAN.get("r1_suffix", "_1.fastq.gz")
RAW_R2_SUFFIX = RAW_SCAN.get("r2_suffix", "_2.fastq.gz")
RAW_STRICT_SCAN = parse_stranded(RAW_SCAN.get("strict", True), "raw_sample_scan.strict")
validate_suffixes(RAW_R1_SUFFIX, RAW_R2_SUFFIX, "raw_sample_scan")
for name, value in config["threads"].items():
    minimum = 0 if name in {"samtools_view", "samtools_sort"} else 1
    if isinstance(value, bool) or not isinstance(value, int) or value < minimum:
        raise ValueError(f"Invalid threads.{name}: {value!r}")
MAPQ = config["alignment"].get("mapq_filter", 0)
if isinstance(MAPQ, bool) or not isinstance(MAPQ, int) or not 0 <= MAPQ <= 255:
    raise ValueError("alignment.mapq_filter must be an integer in [0,255]")
ALIGN_RULE_THREADS = (
    int(config["threads"]["hisat2"])
    + int(config["threads"]["samtools_view"])
    + int(config["threads"]["samtools_sort"])
    + 2  # samtools -@ specifies additional threads; each process also has a main thread.
)
INDEX_RULE_THREADS = int(config["threads"]["samtools_index"])
STRINGTIE_RULE_THREADS = int(config["threads"]["stringtie"])
FASTP_RULE_THREADS = config["threads"].get("fastp", 8)

def discover_samples(source_dir: Path, r1_suffix, r2_suffix, strict, label):
    samples = []
    skipped = []
    if not source_dir.is_dir():
        raise ValueError(f"[ERROR] {label} does not exist or is not a directory: {source_dir}")
    for item in sorted(source_dir.iterdir()):
        if not item.is_dir():
            continue
        sample = item.name
        r1 = item / f"{sample}{r1_suffix}"
        r2 = item / f"{sample}{r2_suffix}"
        if r1.is_file() and r2.is_file() and r1.stat().st_size > 0 and r2.stat().st_size > 0:
            if not re.fullmatch(r"[A-Za-z0-9_][A-Za-z0-9_.-]*", sample):
                raise ValueError(f"Unsupported sample directory name {sample!r}; use letters, digits, underscores, dots and hyphens, starting with a letter, digit or underscore.")
            samples.append(sample)
        else:
            skipped.append((sample, str(r1), str(r2)))
    if skipped and strict:
        details = "\n".join(
            [f"  - {sample}\n    missing pair for:\n    {r1}\n    {r2}" for sample, r1, r2 in skipped]
        )
        raise ValueError(
            f"[ERROR] Missing, empty or invalid FASTQ pairs under {label} while strict=true:\n"
            f"{details}"
        )
    if skipped and not strict:
        print("[WARN] Incomplete sample directories skipped because strict=false:")
        for sample, r1, r2 in skipped:
            print(f"  - {sample}")
            print(f"    expected: {r1}")
            print(f"    expected: {r2}")
    if not samples:
        raise ValueError(
            f"[ERROR] No valid samples found under {source_dir}. "
            f"Expected structure: {source_dir}/{{sample}}/{{sample}}{r1_suffix} and {r2_suffix}"
        )
    print(f"[INFO] Discovered {len(samples)} samples:")
    for s in samples:
        print(f"  - {s}")
    return samples
if FASTP_ENABLED:
    SAMPLES = discover_samples(RAW_DIR, RAW_R1_SUFFIX, RAW_R2_SUFFIX, RAW_STRICT_SCAN, "raw_dir")
else:
    SAMPLES = discover_samples(CLEAN_DIR, R1_SUFFIX, R2_SUFFIX, STRICT_SCAN, "clean_dir")
print(f"[INFO] Input mode: {'raw FASTQ -> fastp -> clean FASTQ' if FASTP_ENABLED else 'existing clean FASTQ'}")
if FASTP_ENABLED:
    print(f"[INFO] fastp polyG trimming: {'enabled' if FASTP_TRIM_POLY_G else 'explicitly disabled'}")
print(f"[INFO] Quantification mode: {'stranded (RSeQC quality gate)' if STRANDED else 'unstranded'}")
print(f"[INFO] Quantification output: {QUANT_DIR}")
def get_r1(wc):
    return str(CLEAN_DIR / wc.sample / f"{wc.sample}{R1_SUFFIX}")
def get_r2(wc):
    return str(CLEAN_DIR / wc.sample / f"{wc.sample}{R2_SUFFIX}")
def get_raw_r1(wc):
    return str(RAW_DIR / wc.sample / f"{wc.sample}{RAW_R1_SUFFIX}")
def get_raw_r2(wc):
    return str(RAW_DIR / wc.sample / f"{wc.sample}{RAW_R2_SUFFIX}")

def overlap(path1, path2):
    left, right = Path(path1).resolve(), Path(path2).resolve()
    return left == right or left in right.parents or right in left.parents

if FASTP_ENABLED:
    roots = {"raw_dir": RAW_DIR, "clean_dir": CLEAN_DIR, "qc_dir": FASTP_QC_DIR}
    for left, right in (("raw_dir", "clean_dir"), ("raw_dir", "qc_dir"), ("clean_dir", "qc_dir")):
        if overlap(roots[left], roots[right]):
            raise ValueError(f"fastp requires disjoint {left} and {right}; overlapping directories could overwrite inputs or outputs")
    for label, directory in (("align_dir", ALIGN_DIR), ("quant_dir", QUANT_DIR), ("logs_dir", LOG_DIR)):
        if overlap(RAW_DIR, directory):
            raise ValueError(f"fastp raw_dir and {label} must not overlap; raw FASTQ inputs must remain unchanged")
    if RAW_DIR.resolve() in XLSX_OUT.resolve().parents or RAW_DIR.resolve() == XLSX_OUT.resolve():
        raise ValueError("output.xlsx must not be inside raw_dir")
    raw_paths, raw_inodes = set(), set()
    raw_directories = {RAW_DIR.resolve()}
    for sample in SAMPLES:
        pair = [RAW_DIR / sample / f"{sample}{suffix}" for suffix in (RAW_R1_SUFFIX, RAW_R2_SUFFIX)]
        if pair[0].samefile(pair[1]):
            raise ValueError(f"Raw FASTQ mates must be different files: {sample}")
        for path in pair:
            raw_paths.add(path.resolve())
            raw_directories.add(path.resolve().parent)
            stat = path.stat()
            raw_inodes.add((stat.st_dev, stat.st_ino))
    output_paths, output_inodes = set(), set()
    for sample in SAMPLES:
        files = [CLEAN_DIR / sample / f"{sample}{suffix}" for suffix in (R1_SUFFIX, R2_SUFFIX)]
        files += [FASTP_QC_DIR / sample / f"{sample}.fastp.{extension}" for extension in ("html", "json")]
        files += [LOG_DIR / sample / "fastp.log"]
        for path in files:
            resolved = path.resolve()
            if any(part in str(path) for part in ("{", "}", "\n", "\r")):
                raise ValueError(f"fastp output paths cannot contain braces or line breaks: {path}")
            if resolved in raw_paths or resolved in output_paths:
                raise ValueError(f"fastp input/output paths overlap: {path}")
            if any(directory == resolved or directory in resolved.parents for directory in raw_directories):
                raise ValueError(f"fastp output resolves inside a raw input directory: {path}")
            if path.exists():
                if not path.is_file():
                    raise ValueError(f"fastp output is not a regular file: {path}")
                stat = path.stat()
                inode = (stat.st_dev, stat.st_ino)
                if inode in raw_inodes or inode in output_inodes:
                    raise ValueError(f"fastp input/output files are linked to the same file: {path}")
                output_inodes.add(inode)
            output_paths.add(resolved)

def index_files(prefix):
    sets = [[f"{prefix}.{i}.{extension}" for i in range(1, 9)] for extension in ("ht2", "ht2l")]
    present = [[path for path in group if Path(path).is_file() and Path(path).stat().st_size > 0] for group in sets]
    complete = [group for group, exists in zip(sets, present) if len(exists) == 8]
    if len(complete) != 1 or all(present):
        raise ValueError(f"Expected exactly one complete, nonempty set of 8 .ht2 or .ht2l HISAT2 index files at {prefix}; found {[len(group) for group in present]}. Check reference.hisat2_index_prefix.")
    return complete[0]

HISAT2_INDEX_FILES = index_files(HISAT2_INDEX_PREFIX)
if not Path(ANNOTATION).is_file() or not Path(ANNOTATION).stat().st_size:
    raise ValueError(f"Reference annotation is missing or empty: {ANNOTATION}; set reference.annotation")
