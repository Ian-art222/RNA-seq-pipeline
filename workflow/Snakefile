            r"""
            mkdir -p {params.log_dir:q}
            python {input.script:q} infer --sample {wildcards.sample:q} \
              --bam {input.bam:q} --bai {input.bai:q} --bed12 {input.bed:q} \
              --output {output.report:q} --log-dir {params.log_dir:q} \
              --sample-size {params.sample_size} --mapq {params.mapq} \
              --min-determinable {params.min_det} --min-dominance {params.min_dom} \
              > {log:q} 2>&1
            """

    rule strandness_gate:
        input:
            report=str(STRAND_QC_DIR / "{sample}.json"),
            script=STRAND_SCRIPT
        output:
            env=STRAND_ENV
        log:
            run=str(STRAND_LOG_DIR / "{sample}" / "gate.log"),
            diagnostic=str(STRAND_LOG_DIR / "{sample}" / "strandness_diagnostic.tsv")
        conda:
            "envs/strandness.yaml"
        shell:
            r"""
            mkdir -p "$(dirname {log.run:q})"
            python {input.script:q} gate --samples {wildcards.sample:q} \
              --reports {input.report:q} --diagnostic {log.diagnostic:q} \
              --output {output.env:q} > {log.run:q} 2>&1
            """

    # Cohort reporting is a terminal branch, never a dependency of a sample's
    # quantification. Each sample uses only its own validated strand direction.
    rule summarize_strandness:
        input:
            reports=expand(str(STRAND_QC_DIR / "{sample}.json"), sample=SAMPLES),
            script=STRAND_SCRIPT
        output:
            diagnostic=STRAND_DIAGNOSTIC
        log:
            str(STRAND_LOG_DIR / "summarize.log")
        params:
            samples=SAMPLES
        conda:
            "envs/strandness.yaml"
        shell:
            r"""
            mkdir -p "$(dirname {log:q})"
            python {input.script:q} summarize --samples {params.samples:q} \
              --reports {input.reports:q} --diagnostic {output.diagnostic:q} > {log:q} 2>&1
            """

rule stringtie_quant:
    input:
        bam=str(ALIGN_DIR / "{sample}" / "{sample}.sorted.bam"),
        bai=str(ALIGN_DIR / "{sample}" / "{sample}.sorted.bam.bai"),
        annotation=NORMALIZED_GTF,
        validation=BAM_VALIDATION,
        extra_inputs=STRINGTIE_EXTRA_INPUTS,
        options_script=str(SCRIPTS_DIR / "workflow_options.py"),
        strand_env=[STRAND_ENV] if STRANDED else [],
        strand_script=[STRAND_SCRIPT] if STRANDED else []
    output:
        gtf=str(QUANT_DIR / "{sample}" / "{sample}.gtf"),
        abundance=str(QUANT_DIR / "{sample}" / "{sample}_abundance.tab"),
        ballgown=BALLGOWN_OUTPUTS
    log:
        str(QUANT_LOG_DIR / "{sample}" / "stringtie_quant.log")
    params:
        ballgown="-B" if USE_BALLGOWN else "",
        extra=shlex.join(stringtie_tokens),
        strand_command=lambda wildcards, input: ("python " + shlex.quote(STRAND_SCRIPT) + " option --env " + shlex.quote(str(input.strand_env[0]))) if STRANDED else "printf ''"
    threads: STRINGTIE_RULE_THREADS
    conda:
        "envs/rnaseq.yaml"
    shell:
        r"""
        set -euo pipefail
        mkdir -p "$(dirname {output.gtf:q})" "$(dirname {log:q})"
        exec > {log:q} 2>&1
        strand_option="$({params.strand_command})"
        echo "[INFO] StringTie strand option: $strand_option"
        stringtie {input.bam:q} \
          -G {input.annotation:q} \
          -p {threads} \
          -A {output.abundance:q} \
          -e \
          $strand_option \
          {params.ballgown} \
          {params.extra} \
          -o {output.gtf:q}
        echo "[INFO] StringTie quantification finished for sample: {wildcards.sample}"
        """
rule build_sample_list:
    input:
        expand(str(QUANT_DIR / "{sample}" / "{sample}.gtf"), sample=SAMPLES)
    output:
        str(QUANT_DIR / "sample_lst.txt")
    log:
        str(QUANT_LOG_DIR / "build_sample_list.log")
    run:
        Path(output[0]).parent.mkdir(parents=True, exist_ok=True)
        Path(log[0]).parent.mkdir(parents=True, exist_ok=True)
        with open(output[0], "w") as out:
            for sample in SAMPLES:
                gtf_path = os.path.abspath(str(QUANT_DIR / sample / f"{sample}.gtf"))
                out.write(f"{sample}\t{gtf_path}\n")
        with open(log[0], "w") as lf:
            lf.write(f"[INFO] Wrote sample list for {len(SAMPLES)} samples: {output[0]}\n")
rule build_alignment_report:
    input:
        summaries=expand(str(ALIGN_DIR / "{sample}" / "{sample}.align_summary.txt"), sample=SAMPLES),
        script=str(SCRIPTS_DIR / "build_alignment_report.py")
    output:
        report=str(ALIGN_DIR / "alignment_report.csv")
    log:
        str(LOG_DIR / "build_alignment_report.log")
    conda:
        "envs/rnaseq.yaml"
    shell:
        r"""
        set -euo pipefail
        mkdir -p "$(dirname {log:q})"
        exec > {log:q} 2>&1
        python {input.script:q} \
          --output {output.report:q} \
          {input.summaries:q}
        """
rule prepde_raw_counts:
    input:
        sample_lst=str(QUANT_DIR / "sample_lst.txt"),
        gtf_files=expand(str(QUANT_DIR / "{sample}" / "{sample}.gtf"), sample=SAMPLES),
        lengths=READ_LENGTHS,
        reference=NORMALIZED_GTF,
        transcript_tables=expand(str(QUANT_DIR / "{sample}" / "t_data.ctab"), sample=SAMPLES) if USE_BALLGOWN else [],
        script=str(PREPDE_SCRIPT),
        reference_parser=BED_SCRIPT
    output:
        raw_count=str(QUANT_DIR / "gene_count_matrix.raw.csv"),
        transcript_count=str(QUANT_DIR / "transcript_count_matrix.csv")
    log:
        str(QUANT_LOG_DIR / "prepde_raw_counts.log")
    params:
        ballgown="--ballgown" if USE_BALLGOWN else ""
    conda:
        "envs/rnaseq.yaml"
    shell:
        r"""
        set -euo pipefail
        mkdir -p "$(dirname {log:q})"
        exec > {log:q} 2>&1
        python {input.script:q} \
          -i {input.sample_lst:q} --read-lengths {input.lengths:q} --gene-id-only \
          --reference {input.reference:q} {params.ballgown} \
          -g {output.raw_count:q} -t {output.transcript_count:q}
        """
rule finalize_expression_matrices:
    input:
        raw_count=str(QUANT_DIR / "gene_count_matrix.raw.csv"),
        abundance_tabs=expand(str(QUANT_DIR / "{sample}" / "{sample}_abundance.tab"), sample=SAMPLES),
        annotation=NORMALIZED_GTF,
        script=str(SCRIPTS_DIR / "build_expression_matrices.py"),
        prepde=str(PREPDE_SCRIPT)
    output:
        count_matrix=str(QUANT_DIR / "gene_count_matrix.csv"),
        fpkm=str(QUANT_DIR / "gene_fpkm_matrix.csv"),
        tpm=str(QUANT_DIR / "gene_tpm_matrix.csv")
    log:
        str(QUANT_LOG_DIR / "finalize_expression_matrices.log")
    params:
        samples=SAMPLES
    conda:
        "envs/rnaseq.yaml"
    shell:
        r"""
        set -euo pipefail
        mkdir -p "$(dirname {log:q})"
        exec > {log:q} 2>&1
        python {input.script:q} \
          --annotation {input.annotation:q} \
          --raw-count {input.raw_count:q} \
          --out-count {output.count_matrix:q} \
          --out-fpkm {output.fpkm:q} \
          --out-tpm {output.tpm:q} \
          --samples {params.samples:q} -- {input.abundance_tabs:q}
        """
rule export_expression_xlsx:
    input:
        alignment_report=str(ALIGN_DIR / "alignment_report.csv"),
        count_matrix=str(QUANT_DIR / "gene_count_matrix.csv"),
        fpkm=str(QUANT_DIR / "gene_fpkm_matrix.csv"),
        tpm=str(QUANT_DIR / "gene_tpm_matrix.csv"),
        script=str(SCRIPTS_DIR / "export_expression_xlsx.py"),
        matrix_script=str(SCRIPTS_DIR / "build_expression_matrices.py"),
        prepde=str(PREPDE_SCRIPT)
    output:
        xlsx=str(XLSX_OUT)
    log:
        str(QUANT_LOG_DIR / "export_expression_xlsx.log")
    conda:
        "envs/rnaseq.yaml"
    shell:
        r"""
        set -euo pipefail
        mkdir -p "$(dirname {log:q})"
        exec > {log:q} 2>&1
        python {input.script:q} \
          --alignment-report {input.alignment_report:q} \
          --count {input.count_matrix:q} \
          --fpkm {input.fpkm:q} \
          --tpm {input.tpm:q} \
          --output {output.xlsx:q}
        """

# Shell redirection opens logs before scripts can validate their own paths.
# Protect every original input against every declared output/log, in both modes.
protected_inputs = [ANNOTATION, *HISAT2_INDEX_FILES, *HISAT_EXTRA_INPUTS, *STRINGTIE_EXTRA_INPUTS]
protected_inputs += [str(path) for path in SCRIPTS_DIR.glob("*.py")]
protected_inputs += [str(path) for path in workflow.configfiles]
if EXTERNAL_BED:
    protected_inputs.append(EXTERNAL_BED)
for sample in SAMPLES:
    directory, suffixes = (RAW_DIR, (RAW_R1_SUFFIX, RAW_R2_SUFFIX)) if FASTP_ENABLED else (CLEAN_DIR, (R1_SUFFIX, R2_SUFFIX))
    protected_inputs.extend(str(directory / sample / f"{sample}{suffix}") for suffix in suffixes)
destinations = []
for item in workflow.rules:
    for kind, paths in (("output", item.output), ("log", item.log)):
        for path in paths:
            destinations.extend((f"{item.name} {kind}", concrete) for concrete in expand(str(path), sample=SAMPLES))
protect_inputs(protected_inputs, destinations)
