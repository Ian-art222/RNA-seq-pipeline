if FASTP_ENABLED:
    rule fastp_clean:
        input:
            r1=get_raw_r1,
            r2=get_raw_r2,
            script=FASTP_SCRIPT,
            read_length_script=READ_LENGTH_SCRIPT,
            validated_reference=ancient(NORMALIZED_GTF)
        output:
            r1=str(CLEAN_DIR / "{sample}" / ("{sample}" + R1_SUFFIX)),
            r2=str(CLEAN_DIR / "{sample}" / ("{sample}" + R2_SUFFIX)),
            html=FASTP_HTML,
            json=FASTP_JSON
        params:
            trim_poly_g=str(FASTP_TRIM_POLY_G).lower(),
            qualified_quality_phred=FASTP_PARAMETERS["qualified_quality_phred"],
            unqualified_percent_limit=FASTP_PARAMETERS["unqualified_percent_limit"],
            n_base_limit=FASTP_PARAMETERS["n_base_limit"],
            length_required=FASTP_PARAMETERS["length_required"]
        log:
            str(LOG_DIR / "{sample}" / "fastp.log")
        threads: FASTP_RULE_THREADS
        conda:
            "envs/fastp.yaml"
        shell:
            r"""
            mkdir -p "$(dirname {log:q})"
            python {input.script:q} --sample {wildcards.sample:q} \
              --r1 {input.r1:q} --r2 {input.r2:q} \
              --out-r1 {output.r1:q} --out-r2 {output.r2:q} \
              --html {output.html:q} --json {output.json:q} --threads {threads} \
              --trim-poly-g {params.trim_poly_g:q} \
              --qualified-quality-phred {params.qualified_quality_phred} \
              --unqualified-percent-limit {params.unqualified_percent_limit} \
              --n-base-limit {params.n_base_limit} --length-required {params.length_required} \
              > {log:q} 2>&1
            """

rule measure_read_lengths:
    input:
        r1=get_r1, r2=get_r2, script=READ_LENGTH_SCRIPT,
        validated_reference=ancient(NORMALIZED_GTF)
    output:
        report=READ_LENGTH_REPORT
    log:
        str(LOG_DIR / "{sample}" / "read_lengths.log")
    conda:
        "envs/rnaseq.yaml"
    shell:
        r"""
        mkdir -p "$(dirname {log:q})"
        python {input.script:q} measure --sample {wildcards.sample:q} \
          --r1 {input.r1:q} --r2 {input.r2:q} --output {output.report:q} > {log:q} 2>&1
        """

rule collect_read_lengths:
    input:
        reports=expand(READ_LENGTH_REPORT, sample=SAMPLES), script=READ_LENGTH_SCRIPT
    output:
        lengths=READ_LENGTHS
    params:
        samples=SAMPLES
    log:
        str(LOG_DIR / "collect_read_lengths.log")
    conda:
        "envs/rnaseq.yaml"
    shell:
        r"""
        mkdir -p "$(dirname {log:q})"
        python {input.script:q} combine --samples {params.samples:q} \
          --reports {input.reports:q} --output {output.lengths:q} > {log:q} 2>&1
        """

rule hisat2_align_sort:
    input:
        r1=get_r1,
        r2=get_r2,
        read_lengths=READ_LENGTH_REPORT,
        validated_reference=ancient(NORMALIZED_GTF),
        index_files=HISAT2_INDEX_FILES,
        splice_inputs=HISAT_EXTRA_INPUTS,
        script=str(SCRIPTS_DIR / "align_reads.py")
    output:
        bam=str(ALIGN_DIR / "{sample}" / "{sample}.sorted.bam"),
        summary=str(ALIGN_DIR / "{sample}" / "{sample}.align_summary.txt")
    log:
        str(LOG_DIR / "{sample}" / "hisat2_align_sort.log")
    params:
        index=HISAT2_INDEX_PREFIX,
        hisat2_extra=config["alignment"].get("hisat2_extra", ""),
        mapq=MAPQ,
        hisat2_threads=int(config["threads"]["hisat2"]),
        view_threads=int(config["threads"]["samtools_view"]),
        sort_threads=int(config["threads"]["samtools_sort"])
    threads: ALIGN_RULE_THREADS
    conda:
        "envs/rnaseq.yaml"
    shell:
        r"""
        mkdir -p "$(dirname {log:q})"
        python {input.script:q} --r1 {input.r1:q} --r2 {input.r2:q} \
          --index {params.index:q} --bam {output.bam:q} --summary {output.summary:q} \
          --threads {threads} --hisat2-threads {params.hisat2_threads} \
          --view-threads {params.view_threads} --sort-threads {params.sort_threads} \
          --mapq {params.mapq} --hisat2-extra={params.hisat2_extra:q} > {log:q} 2>&1
        """
rule samtools_index:
    input:
        bam=str(ALIGN_DIR / "{sample}" / "{sample}.sorted.bam")
    output:
        bai=str(ALIGN_DIR / "{sample}" / "{sample}.sorted.bam.bai")
    log:
        str(LOG_DIR / "{sample}" / "samtools_index.log")
    threads: INDEX_RULE_THREADS
    params:
        extra_threads=lambda wildcards, threads: max(0, threads - 1)
    conda:
        "envs/rnaseq.yaml"
    shell:
        r"""
        set -euo pipefail
        mkdir -p "$(dirname {log:q})"
        exec > {log:q} 2>&1
        echo "[INFO] samtools index started for sample: {wildcards.sample}"
        samtools index -@ {params.extra_threads} {input.bam:q} {output.bai:q}
        echo "[INFO] samtools index finished for sample: {wildcards.sample}"
        """
rule prepare_reference:
    input:
        annotation=ANNOTATION,
        external_bed=[EXTERNAL_BED] if EXTERNAL_BED else [],
        script=BED_SCRIPT
    output:
        bed=STRAND_BED,
        gtf=NORMALIZED_GTF
    log:
        run=str(QUANT_LOG_DIR / "reference" / "prepare_bed.log"),
        report=str(QUANT_LOG_DIR / "reference" / "prepare_bed.json")
    params:
        bed_option=("--bed12 " + shlex.quote(EXTERNAL_BED)) if EXTERNAL_BED else ""
    conda:
        "envs/strandness.yaml"
    shell:
        r"""
        mkdir -p "$(dirname {log.run:q})"
        python {input.script:q} --annotation {input.annotation:q} \
          --output {output.bed:q} --normalized-gtf {output.gtf:q} --report {log.report:q} \
          {params.bed_option} > {log.run:q} 2>&1
        """


